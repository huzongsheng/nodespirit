from http.server import BaseHTTPRequestHandler, HTTPServer
import json
import time
import uuid


MODEL_NAME = "kimi-mobile"


def get_text_from_content(content):
    """
    OpenAI 的 content 可能是：
    "你好"

    也可能是：
    [
        {
            "type": "text",
            "text": "你好"
        }
    ]
    """

    if isinstance(content, str):
        return content

    if isinstance(content, list):
        texts = []

        for item in content:

            if not isinstance(item, dict):
                continue

            if item.get("type") == "text":
                texts.append(
                    item.get("text", "")
                )

        return "\n".join(texts)

    return str(content)


def messages_to_prompt(messages):
    """
    把 OpenAI messages 转换成一个完整 Prompt。

    例如：

    [
        {"role": "system", "content": "你是翻译助手"},
        {"role": "user", "content": "你好"},
        {"role": "assistant", "content": "你好！"},
        {"role": "user", "content": "翻译成英语"}
    ]

    转换成：

    [系统]
    你是翻译助手

    [用户]
    你好

    [助手]
    你好！

    [用户]
    翻译成英语
    """

    result = []

    role_names = {
        "system": "系统",
        "developer": "系统",
        "user": "用户",
        "assistant": "助手"
    }

    for message in messages:

        role = message.get("role", "user")
        content = get_text_from_content(
            message.get("content", "")
        )

        role_name = role_names.get(
            role,
            role
        )

        result.append(
            "[" + role_name + "]\n" + content
        )

    return "\n\n".join(result)


class ApiHandler(BaseHTTPRequestHandler):

    # =========================
    # 返回 JSON
    # =========================

    def send_json(self, data, status=200):

        body = (
            json.dumps(
                data,
                ensure_ascii=False
            )
            + "\n"
        ).encode("utf-8")

        self.send_response(status)

        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8"
        )

        self.send_header(
            "Content-Length",
            str(len(body))
        )

        # 允许网页跨域调用
        self.send_header(
            "Access-Control-Allow-Origin",
            "*"
        )

        self.end_headers()

        self.wfile.write(body)


    # =========================
    # OPTIONS
    # =========================

    def do_OPTIONS(self):

        self.send_response(204)

        self.send_header(
            "Access-Control-Allow-Origin",
            "*"
        )

        self.send_header(
            "Access-Control-Allow-Headers",
            "Content-Type, Authorization"
        )

        self.send_header(
            "Access-Control-Allow-Methods",
            "GET, POST, OPTIONS"
        )

        self.end_headers()


    # =========================
    # GET
    # =========================

    def do_GET(self):

        # OpenAI 模型列表
        if self.path == "/v1/models":

            now = int(time.time())

            result = {
                "object": "list",
                "data": [
                    {
                        "id": MODEL_NAME,
                        "object": "model",
                        "created": now,
                        "owned_by": "local"
                    }
                ]
            }

            self.send_json(result)
            return


        # 简单首页
        if self.path == "/":

            self.send_json({
                "message": "Kimi OpenAI Compatible API",
                "model": MODEL_NAME,
                "endpoint": "/v1/chat/completions"
            })

            return


        self.send_json({
            "error": {
                "message": "Not Found",
                "type": "invalid_request_error"
            }
        }, 404)


    # =========================
    # POST
    # =========================

    def do_POST(self):

        # 只处理 OpenAI Chat Completions
        if self.path != "/v1/chat/completions":

            self.send_json({
                "error": {
                    "message": "API endpoint not found",
                    "type": "invalid_request_error"
                }
            }, 404)

            return


        # =========================
        # 读取请求 Body
        # =========================

        try:

            content_length = int(
                self.headers.get(
                    "Content-Length",
                    0
                )
            )

            body = self.rfile.read(
                content_length
            )

            data = json.loads(
                body.decode("utf-8")
            )

        except Exception as e:

            self.send_json({
                "error": {
                    "message": "JSON 格式错误: " + str(e),
                    "type": "invalid_request_error"
                }
            }, 400)

            return


        # =========================
        # 读取 OpenAI 参数
        # =========================

        model = data.get(
            "model",
            MODEL_NAME
        )

        messages = data.get(
            "messages",
            []
        )

        stream = data.get(
            "stream",
            False
        )


        if not messages:

            self.send_json({
                "error": {
                    "message": "messages 不能为空",
                    "type": "invalid_request_error"
                }
            }, 400)

            return


        # =========================
        # messages → Prompt
        # =========================

        prompt = messages_to_prompt(
            messages
        )

        print("收到 OpenAI API 请求：")
        print(prompt)


        # =========================
        # 调用你的 Kimi
        # =========================

        try:

            answer = kimi(prompt)

        except Exception as e:

            self.send_json({
                "error": {
                    "message": str(e),
                    "type": "server_error"
                }
            }, 500)

            return


        completion_id = (
            "chatcmpl-" +
            uuid.uuid4().hex
        )

        created = int(time.time())


        # =========================
        # stream=true
        # =========================

        if stream:

            self.send_response(200)

            self.send_header(
                "Content-Type",
                "text/event-stream; charset=utf-8"
            )

            self.send_header(
                "Cache-Control",
                "no-cache"
            )

            self.send_header(
                "Access-Control-Allow-Origin",
                "*"
            )

            self.end_headers()


            # 第一块：回答内容
            chunk = {
                "id": completion_id,
                "object": "chat.completion.chunk",
                "created": created,
                "model": model,
                "choices": [
                    {
                        "index": 0,
                        "delta": {
                            "role": "assistant",
                            "content": answer
                        },
                        "logprobs": None,
                        "finish_reason": None
                    }
                ]
            }

            text = (
                "data: "
                + json.dumps(
                    chunk,
                    ensure_ascii=False
                )
                + "\n\n"
            )

            self.wfile.write(
                text.encode("utf-8")
            )

            self.wfile.flush()


            # 第二块：结束
            end_chunk = {
                "id": completion_id,
                "object": "chat.completion.chunk",
                "created": created,
                "model": model,
                "choices": [
                    {
                        "index": 0,
                        "delta": {},
                        "logprobs": None,
                        "finish_reason": "stop"
                    }
                ]
            }

            text = (
                "data: "
                + json.dumps(
                    end_chunk,
                    ensure_ascii=False
                )
                + "\n\n"
            )

            self.wfile.write(
                text.encode("utf-8")
            )

            self.wfile.write(
                b"data: [DONE]\n\n"
            )

            self.wfile.flush()

            return


        # =========================
        # 普通非流式响应
        # =========================

        result = {

            "id": completion_id,

            "object": "chat.completion",

            "created": created,

            "model": model,

            "choices": [
                {
                    "index": 0,

                    "message": {
                        "role": "assistant",
                        "content": answer
                    },

                    "logprobs": None,

                    "finish_reason": "stop"
                }
            ],

            # 你的 Kimi UI 自动化没办法知道真正 token 数
            "usage": {
                "prompt_tokens": 0,
                "completion_tokens": 0,
                "total_tokens": 0
            }
        }

        self.send_json(result)


