def kimi(question):
    system.open("com.moonshot.kimichat")
    while Selector(0).desc("导航按钮").find() == None:
        time.sleep(0.1)

    if Selector(0).desc("开启新会话").find():
        Selector(0).desc("开启新会话").find().click()
    time.sleep(0.5)
    Selector(0).text("尽管问，带图也行").find().parent(1).input(question)
    time.sleep(0.3)
    a = Selector(0).desc("发送讯息").find()
    action.click(a.rect.centerX(), a.rect.centerY())
    time.sleep(0.5)
    while Selector(1).desc("发送讯息").clickable(True).find() :
        time.sleep(0.5)
    if Selector(1).desc("JumpToBottom").parent(1).find():
        Selector(1).desc("JumpToBottom").parent(1).find().click()
        time.sleep(0.5)
    Selector(1).desc("复制").find().click()

    print(Clipboard.get())
    return Clipboard.get()

